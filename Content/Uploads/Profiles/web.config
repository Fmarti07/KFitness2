<?xml version="1.0"?>
<configuration>
  <system.webServer>
    <!-- Bloquear acceso directo por URL a los archivos estáticos en esta carpeta. -->
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <add name="BlockStaticFiles" path="*" verb="*" type="System.Web.HttpForbiddenHandler" preCondition="integratedMode" />
    </handlers>
  </system.webServer>
</configuration>
