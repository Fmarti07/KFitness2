<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="KFitnessConnection" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=KFitness;Integrated Security=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="PublicAppBaseUrl" value="https://localhost:44300" />
    <add key="ResetPasswordPath" value="/restablecer-contrasena.html" />
    <add key="SmtpHost" value="smtp-relay.brevo.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUser" value="bdbeaf001@smtp-brevo.com" />
    <add key="SmtpPassword" value="" />
    <add key="SmtpEnableSsl" value="true" />
    <add key="MailFromAddress" value="flordelismg07@gmail.com" />
    <add key="MailFromName" value="KFitness" />
    <add key="OpenAI.Rutinas.Endpoint" value="https://api.openai.com/v1/chat/completions" />
    <add key="OpenAI.Rutinas.Model" value="gpt-4o-mini" />
    <add key="OpenAI.Rutinas.ApiKey" value="" />
    <add key="OpenAI.Rutinas.TimeoutMs" value="20000" />
    <add key="OpenAI.Rutinas.MaxRequestsPerWindow" value="5" />
    <add key="OpenAI.Rutinas.WindowMinutes" value="60" />
  </appSettings>
  <system.webServer>
    <!-- Hace que index.html se cargue al entrar a la raiz del sitio -->
    <defaultDocument enabled="true">
      <files>
        <clear/>
        <add value="index.html"/>
      </files>
    </defaultDocument>
    <!-- Asegura los tipos MIME correctos para los recursos estaticos -->
    <staticContent>
      <remove fileExtension=".svg"/>
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml"/>
      <remove fileExtension=".json"/>
      <mimeMap fileExtension=".json" mimeType="application/json"/>
      <remove fileExtension=".woff"/>
      <mimeMap fileExtension=".woff" mimeType="font/woff"/>
      <remove fileExtension=".woff2"/>
      <mimeMap fileExtension=".woff2" mimeType="font/woff2"/>
    </staticContent>
    <!-- Permitir cargas de hasta 5 MB -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="5242880" />
      </requestFiltering>
    </security>
  </system.webServer>
  <system.web>
    <!-- Ajuste para permitir uploads de hasta 5 MB (valor en KB) -->
    <httpRuntime maxRequestLength="32768" executionTimeout="3600" />
    <compilation debug="true">
      <assemblies>
        <add assembly="System.Core, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
        <add assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
        <add assembly="WindowsBase, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
      </assemblies>
    </compilation>
    <authentication mode="Forms">
      <forms loginUrl="/login.html" protection="All" timeout="30" slidingExpiration="true" />
    </authentication>
  </system.web>

  <location path="api/admin/routines-save.ashx">
    <system.webServer><security><requestFiltering><requestLimits maxAllowedContentLength="33554432" /></requestFiltering></security></system.webServer>
  </location>
  <location path="admin.html">
    <system.web>
      <authorization>
        <deny users="?" />
      </authorization>
    </system.web>
  </location>

  <location path="api/admin">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
